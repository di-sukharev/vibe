---
interface Props {
  compact?: boolean
}

const { compact = false } = Astro.props
---

<span class="inline-flex items-center gap-2.5" aria-label="Northstar">
  <span
    class="grid size-8 place-items-center rounded-lg bg-primary text-sm font-semibold text-primary-foreground shadow-sm"
    aria-hidden="true"
  >
    N
  </span>
  {!compact && <span class="font-heading text-base font-semibold tracking-tight">Northstar</span>}
</span>
