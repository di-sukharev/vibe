---
import { Database, LayoutTemplate, MonitorSmartphone, Smartphone } from 'lucide-react'

const scenarios = [
  {
    icon: LayoutTemplate,
    title: 'Сайты и лендинги',
    description: 'Соберите сайт продукта, каталог или промостраницу из готовых адаптивных секций.',
  },
  {
    icon: MonitorSmartphone,
    title: 'Веб-приложения',
    description: 'Добавьте личный кабинет, панель управления, формы и действия пользователей.',
  },
  {
    icon: Smartphone,
    title: 'Мобильное приложение',
    description: 'Соберите приложение для iPhone и Android, которое работает с тем же сервером.',
  },
  {
    icon: Database,
    title: 'Аккаунты и данные',
    description: 'Добавьте вход, хранение данных и внешние сервисы, когда они понадобятся продукту.',
  },
]
---

<section class="border-b bg-primary py-20 text-primary-foreground sm:py-24" id="scenarios" aria-labelledby="scenarios-title">
  <div class="site-container">
    <div class="grid items-end gap-6 lg:grid-cols-[1fr_0.7fr]">
      <div>
        <p class="text-sm font-semibold tracking-wide text-emerald-300 uppercase">Что можно собрать</p>
        <h2 class="mt-3 max-w-3xl font-heading text-3xl font-semibold tracking-tight text-balance sm:text-4xl" id="scenarios-title">
          Соберите одну часть или весь продукт
        </h2>
      </div>
      <p class="text-base leading-7 text-primary-foreground/65 text-pretty sm:text-lg lg:justify-self-end">
        Начните с того, что нужно сейчас. Остальные части можно подключить позже в том же проекте.
      </p>
    </div>

    <div class="mt-12 grid gap-px overflow-hidden rounded-2xl bg-white/10 ring-1 ring-white/10 sm:grid-cols-2">
      {scenarios.map(({ icon: Icon, title, description }, index) => (
        <article class="group relative min-h-64 bg-primary p-7 transition-colors hover:bg-white/5 sm:p-8">
          <div class="flex items-start justify-between gap-4">
            <span class="grid size-11 place-items-center rounded-xl bg-white/10 text-emerald-300 transition-colors group-hover:bg-emerald-300 group-hover:text-emerald-950">
              <Icon className="size-5" aria-hidden="true" />
            </span>
            <span class="font-heading text-sm font-semibold text-white/25">0{index + 1}</span>
          </div>
          <h3 class="mt-12 max-w-sm font-heading text-xl font-semibold">{title}</h3>
          <p class="mt-3 max-w-md leading-6 text-primary-foreground/60">{description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
