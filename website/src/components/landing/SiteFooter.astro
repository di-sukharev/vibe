---
import { Separator } from '@/components/ui/separator'
import BrandMark from './BrandMark.astro'

const year = new Date().getFullYear()
---

<footer class="border-t bg-muted/25">
  <div class="site-container py-10">
    <div class="flex flex-col justify-between gap-8 md:flex-row md:items-start">
      <div class="max-w-sm">
        <a class="rounded-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" href="#top">
          <BrandMark />
        </a>
        <p class="mt-4 text-sm leading-6 text-muted-foreground">
          Шаблон ЙЙ для создания сайтов и приложений с ИИ.
        </p>
      </div>
      <nav class="grid grid-cols-2 gap-x-10 gap-y-3 text-sm" aria-label="Навигация в подвале">
        <a class="text-muted-foreground hover:text-foreground" href="#features">Как работает</a>
        <a class="text-muted-foreground hover:text-foreground" href="#launch-kit">Что входит</a>
        <a class="text-muted-foreground hover:text-foreground" href="#scenarios">Что можно собрать</a>
        <a class="text-muted-foreground hover:text-foreground" href="#faq">Вопросы</a>
        <a class="text-muted-foreground hover:text-foreground" href="#top">Наверх</a>
      </nav>
    </div>
    <Separator className="my-8" />
    <div class="flex flex-col justify-between gap-3 text-xs text-muted-foreground sm:flex-row">
      <p>
        © {year} ЙЙ · Автор шаблона —{' '}
        <a
          class="font-medium text-foreground underline decoration-border underline-offset-4 transition-colors hover:decoration-foreground"
          href="https://sukharev.dev"
        >sukharev.dev</a>
      </p>
      <p>Astro · React · Expo · Hono · Prisma</p>
    </div>
  </div>
</footer>
