---
interface Props {
  align?: 'center' | 'left'
  description: string
  eyebrow: string
  title: string
  titleId?: string
}

const { align = 'left', description, eyebrow, title, titleId } = Astro.props
---

<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center']}>
  <p class="text-sm font-bold tracking-[0.16em] text-white/55 uppercase">{eyebrow}</p>
  <h2 class="glow-text mt-3 font-heading text-3xl font-bold tracking-tight text-balance sm:text-4xl" id={titleId}>
    {title}
  </h2>
  <p class="mt-4 text-base leading-7 text-muted-foreground text-pretty sm:text-lg">
    {description}
  </p>
</div>
