---
import { Badge } from '@/components/ui/badge'
import { Card, CardContent } from '@/components/ui/card'
import SectionIntro from './SectionIntro.astro'

const steps = [
  {
    number: '01',
    title: 'Замените шаблонный контент',
    description: 'Опишите продукт, ценность и главное действие простыми словами вашей аудитории.',
  },
  {
    number: '02',
    title: 'Настройте визуальный характер',
    description: 'Обновите токены цвета, шрифт и акценты — компоненты подстроятся автоматически.',
  },
  {
    number: '03',
    title: 'Добавьте продуктовые детали',
    description: 'Подключайте формы, данные и новые страницы только там, где они действительно нужны.',
  },
]
---

<section class="border-b bg-muted/35 py-20 sm:py-24" id="process" aria-labelledby="process-title">
  <div class="site-container grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
    <div id="process-title">
      <SectionIntro
        eyebrow="Как это работает"
        title="Три понятных шага до своего продукта"
        description="Шаблон задаёт направление, но не ограничивает развитие. Начните с малого и усложняйте систему только вслед за реальной задачей."
      />
    </div>
    <ol class="grid gap-4">
      {steps.map((step) => (
        <li>
          <Card className="py-0">
            <CardContent className="grid gap-4 p-5 sm:grid-cols-[auto_1fr] sm:items-start sm:p-6">
              <Badge className="h-8 min-w-11 bg-emerald-100 text-emerald-800" variant="secondary">
                {step.number}
              </Badge>
              <div>
                <h3 class="font-heading text-lg font-semibold">{step.title}</h3>
                <p class="mt-2 leading-6 text-muted-foreground">{step.description}</p>
              </div>
            </CardContent>
          </Card>
        </li>
      ))}
    </ol>
  </div>
</section>
