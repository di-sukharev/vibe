---
import { Badge } from '@/components/ui/badge'
import { Card, CardContent } from '@/components/ui/card'
import SectionIntro from './SectionIntro.astro'

const steps = [
  {
    number: '01',
    title: 'Опишите продукт',
    description: 'Кто будет им пользоваться, какую проблему он решает и что пользователь должен сделать в первую очередь.',
  },
  {
    number: '02',
    title: 'Поставьте одну задачу',
    description: 'Например: собрать главный экран, добавить форму заявки или подключить данные. Агент внесёт изменения и запустит проверки.',
  },
  {
    number: '03',
    title: 'Проверьте результат',
    description: 'Откройте страницу или приложение. Если сценарий работает как задумано и проверки прошли, переходите к следующей задаче.',
  },
]
---

<section class="border-b bg-muted/35 py-20 sm:py-24" id="process" aria-labelledby="process-title">
  <div class="site-container grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
    <div>
      <SectionIntro
        eyebrow="С чего начать"
        title="Первая проверяемая задача — в три шага"
        titleId="process-title"
        description="Опишите продукт, поставьте агенту одну конкретную задачу и проверьте результат. После этого переходите к следующей функции."
      />
    </div>
    <ol class="grid gap-4">
      {steps.map((step) => (
        <li>
          <Card className="py-0">
            <CardContent className="grid gap-4 p-5 sm:grid-cols-[auto_1fr] sm:items-start sm:p-6">
              <Badge className="h-8 min-w-11 font-bold tabular-nums" variant="secondary">
                {step.number}
              </Badge>
              <div>
                <h3 class="font-heading text-lg font-bold">{step.title}</h3>
                <p class="mt-2 leading-6 text-muted-foreground">{step.description}</p>
              </div>
            </CardContent>
          </Card>
        </li>
      ))}
    </ol>
  </div>
</section>
