# Public build-time configuration for the website. Vite inlines every VITE_* value into
# the static output, so nothing here may be secret. Copy this file to website/.env when a local
# build should carry these values.

# Canonical origin of this website, such as https://www.example.com. Set: pages emit canonical
# and og:url metadata. Empty: they omit it, which is the right local default.
VITE_WEBSITE_URL=

# Origin of the authenticated web app: an absolute http(s) URL, or empty. Empty: the landing page
# keeps its local next-step link and the site builds without a web app. Anything that is not an
# absolute http(s) URL fails the build with an error naming this variable.
VITE_WEBAPP_URL=
