# Local PostgreSQL from ../docker-compose.yml.
# Keep an explicit username and password in Prisma URLs even on local machines.
# Peer-auth style URLs without a user can produce opaque Prisma schema-engine errors.
DATABASE_URL="postgresql://superuser:superpassword@localhost:54329/web_app_demo?schema=public"

# Test PostgreSQL from ../docker-compose.yml. Backend integration, Docker smoke,
# and Playwright E2E use this shape and must target the *_test database.
TEST_DATABASE_URL="postgresql://superuser:superpassword@localhost:54330/web_app_demo_test?schema=public"

# Idempotent local administrator seed. Leave the password empty for a locked
# admin, or set 8-128 characters locally before `bun run prisma:seed`.
# Production backend-initial spec generation requires 12-128 non-placeholder
# characters and exposes these values only to the PRE_DEPLOY job.
ADMIN_SEED_EMAIL="admin@example.com"
ADMIN_SEED_PASSWORD=""

JWT_SECRET="replace-with-at-least-32-random-characters"
CORS_ORIGINS="http://localhost:5173,http://localhost:8081,http://localhost:19006"
# Public browser-app origin used in transactional links such as password reset.
WEBAPP_ORIGIN="http://localhost:5173"
ACCESS_TOKEN_TTL_SECONDS="900"
REFRESH_TOKEN_TTL_DAYS="30"
REFRESH_REUSE_GRACE_SECONDS="10"
SESSION_ABSOLUTE_TTL_DAYS="90"
SESSION_RETENTION_DAYS="7"
AUTH_BODY_LIMIT_BYTES="65536"
AUTH_RATE_LIMIT_MAX="60"
AUTH_RATE_LIMIT_WINDOW_SECONDS="60"
IAP_BODY_LIMIT_BYTES="65536"
IAP_RATE_LIMIT_MAX="60"
IAP_RATE_LIMIT_WINDOW_SECONDS="60"
WEBHOOK_BODY_LIMIT_BYTES="262144"
WEBHOOK_RATE_LIMIT_MAX="600"
WEBHOOK_RATE_LIMIT_WINDOW_SECONDS="60"
SHUTDOWN_GRACE_SECONDS="20"
TRUST_PROXY="false"
# Required when TRUST_PROXY=true. Use do-connecting-ip on DigitalOcean App Platform.
# For a comma-separated proxy chain, set first or last to match the provider contract.
# TRUSTED_PROXY_CLIENT_IP_HEADER="do-connecting-ip"
# TRUSTED_PROXY_CLIENT_IP_POSITION="first"
COOKIE_SECURE="false"

# Optional mobile social auth. These are provider identifiers, not secrets.
# APPLE_AUTH_BUNDLE_ID must match mobile ios.bundleIdentifier.
# GOOGLE_AUTH_CLIENT_IDS is a comma-separated allowlist containing every Google
# OAuth client ID whose ID tokens this backend should accept.
APPLE_AUTH_BUNDLE_ID=""
APPLE_AUTH_JWKS_TIMEOUT_MS="5000"
GOOGLE_AUTH_CLIENT_IDS=""

# Optional DigitalOcean Spaces storage. Leave blank until the product needs
# uploads, media, or other persistent files.
SPACES_REGION=""
SPACES_BUCKET=""
SPACES_ENDPOINT=""
SPACES_CDN_BASE_URL=""
SPACES_ACCESS_KEY_ID=""
SPACES_SECRET_ACCESS_KEY=""
SPACES_UPLOAD_MAX_BYTES="10485760"
SPACES_UPLOAD_URL_TTL_SECONDS="900"
SPACES_DOWNLOAD_URL_TTL_SECONDS="300"
SPACES_PUBLIC_CACHE_CONTROL="public, max-age=31536000, immutable"

# Optional iOS App Store subscription verification. Leave credentials blank until
# App Store Connect products and API credentials are ready. Official Apple root
# certificates are bundled; APPLE_IAP_ROOT_CERTS_DIR is an optional override.
# When credentials are set, APPLE_IAP_PRODUCT_IDS must list every allowed product.
APPLE_IAP_BUNDLE_ID=""
APPLE_IAP_APP_APPLE_ID=""
APPLE_IAP_ENVIRONMENT="Sandbox"
APPLE_IAP_ISSUER_ID=""
APPLE_IAP_KEY_ID=""
APPLE_IAP_PRIVATE_KEY_BASE64=""
APPLE_IAP_ROOT_CERTS_DIR=""
APPLE_IAP_PRODUCT_IDS="com.example.app.premium.monthly,com.example.app.premium.yearly"

# Optional Google Play subscription verification. Leave credentials blank until
# Play Console products, base plans, and Android Publisher API access are ready.
# When credentials are set, both product and base-plan allowlists are required.
# Product/base-plan examples are public identifiers; the service-account JSON is a
# backend secret and should be base64-encoded before deployment.
GOOGLE_PLAY_PACKAGE_NAME=""
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_BASE64=""
GOOGLE_PLAY_PRODUCT_IDS="com.example.app.premium"
GOOGLE_PLAY_BASE_PLAN_IDS="monthly,yearly"

# Optional Expo Push access token. Leave blank unless the Expo project enables
# push security. APNs/FCM credentials are configured in Expo/EAS, not here.
EXPO_PUSH_ACCESS_TOKEN=""
ENABLE_TEST_PUSH="false"
PUSH_TOKEN_MAX_PER_USER="10"
PUSH_OUTBOX_PROCESS_LIMIT=""
PUSH_OUTBOX_PROCESS_MAX_LOOPS=""
PUSH_OUTBOX_PROCESS_MAX_RUNTIME_MS=""
PUSH_OUTBOX_PROCESSING_STALE_MS=""
PUSH_RECEIPT_CHECK_LIMIT=""
