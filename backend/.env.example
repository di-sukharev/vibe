# Local PostgreSQL from ../docker-compose.yml.
# Keep an explicit username and password in Prisma URLs even on local machines.
# Peer-auth style URLs without a user can produce opaque Prisma schema-engine errors.
POSTGRES_PORT=54329
DATABASE_URL="postgresql://superuser:superpassword@localhost:54329/web_app_demo?schema=public"

# Test PostgreSQL from ../docker-compose.yml. Backend integration, Docker smoke,
# and Playwright E2E use this shape and must target the *_test database.
POSTGRES_TEST_PORT=54330
TEST_DATABASE_URL="postgresql://superuser:superpassword@localhost:54330/web_app_demo_test?schema=public"

# Public local-only demo accounts created by `bun run dev:seed`. The ordinary
# user also receives a development premium entitlement for mobile exploration.
# Change these values in the ignored backend/.env; never reuse them in production.
DEV_SEED_ADMIN_EMAIL="admin@example.com"
DEV_SEED_ADMIN_PASSWORD="local-admin-password"
DEV_SEED_USER_EMAIL="user@example.com"
DEV_SEED_USER_PASSWORD="local-user-password"

# Initial production administrator bootstrap. Backend-initial spec generation
# requires 12-128 non-placeholder password characters and exposes these values
# only to the PRE_DEPLOY job. The local development seed does not read them.
ADMIN_SEED_EMAIL="admin@example.com"
ADMIN_SEED_PASSWORD=""

JWT_SECRET="replace-with-at-least-32-random-characters"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://localhost:19006"
# Public browser-app origin used in transactional links such as password reset.
WEBAPP_ORIGIN="http://localhost:5173"
ACCESS_TOKEN_TTL_SECONDS="900"
REFRESH_TOKEN_TTL_DAYS="30"
REFRESH_REUSE_GRACE_SECONDS="10"
SESSION_ABSOLUTE_TTL_DAYS="90"
SESSION_RETENTION_DAYS="7"
AUTH_BODY_LIMIT_BYTES="65536"
# local keeps the bounded process-local ingress limiter. Use yandex-sws only after
# the documented Smart Web Security ARL profile is active and verified.
INGRESS_RATE_LIMIT_PROVIDER="local"
AUTH_RATE_LIMIT_MAX="60"
AUTH_RATE_LIMIT_WINDOW_SECONDS="60"
ADMIN_USERS_READ_RATE_LIMIT_MAX="120"
ADMIN_USERS_READ_RATE_LIMIT_WINDOW_SECONDS="60"
IAP_BODY_LIMIT_BYTES="65536"
IAP_RATE_LIMIT_MAX="60"
IAP_RATE_LIMIT_WINDOW_SECONDS="60"
WEBHOOK_BODY_LIMIT_BYTES="262144"
WEBHOOK_RATE_LIMIT_MAX="600"
WEBHOOK_RATE_LIMIT_WINDOW_SECONDS="60"
SHUTDOWN_GRACE_SECONDS="20"

# Email. Four drivers: disabled, console, postbox (Yandex Cloud), resend. See docs/EMAIL.md.
# "console" prints messages instead of sending them, so a fresh checkout can follow a password
# reset link locally with no provider account; production refuses it. The schema default is
# "disabled", so a deployment that forgets this variable sends nothing rather than logging mail.
EMAIL_DELIVERY="console"
# Required once a provider is selected, together with WEBAPP_ORIGIN, which builds the links.
EMAIL_FROM=""
EMAIL_REPLY_TO=""
EMAIL_REQUEST_TIMEOUT_MS="10000"
# Yandex Cloud Postbox: a static access key for a service account with the sender role.
EMAIL_POSTBOX_ACCESS_KEY_ID=""
EMAIL_POSTBOX_SECRET_ACCESS_KEY=""
EMAIL_POSTBOX_ENDPOINT="https://postbox.cloud.yandex.net"
EMAIL_POSTBOX_REGION="ru-central1"
EMAIL_POSTBOX_CONFIGURATION_SET=""
# Resend.
EMAIL_RESEND_API_KEY=""
EMAIL_RESEND_ENDPOINT="https://api.resend.com"

# Task outbox. Defaults suit a drain running once a minute; see docs/BACKGROUND_JOBS.md.
# Rows fetched per loop, and the whole-pass budget checked between tasks.
TASK_OUTBOX_BATCH_LIMIT="50"
TASK_OUTBOX_MAX_RUNTIME_MS="55000"
# How long a claimed row may look busy before another drain may take it. Floored in code at twice
# the slowest task deadline, so a lease can never expire while an attempt is still running.
TASK_OUTBOX_LEASE_STALE_MS="120000"
# Finished rows lose their payload immediately; this is when the audit skeleton is deleted.
TASK_OUTBOX_RETENTION_DAYS="30"
TRUST_PROXY="false"
# Required when TRUST_PROXY=true. Use do-connecting-ip on DigitalOcean App Platform.
# For a comma-separated proxy chain, set first or last to match the provider contract.
# TRUSTED_PROXY_CLIENT_IP_HEADER="do-connecting-ip"
# TRUSTED_PROXY_CLIENT_IP_POSITION="first"
COOKIE_SECURE="false"

# Optional mobile social auth. These are provider identifiers, not secrets.
# APPLE_AUTH_BUNDLE_ID must match mobile ios.bundleIdentifier.
# GOOGLE_AUTH_CLIENT_IDS is a comma-separated allowlist containing every Google
# OAuth client ID whose ID tokens this backend should accept.
APPLE_AUTH_BUNDLE_ID=""
APPLE_AUTH_JWKS_TIMEOUT_MS="5000"
GOOGLE_AUTH_CLIENT_IDS=""

# Private file storage.
#
# filesystem is the default and needs nothing installed: uploads go to backend/.storage.
# Switch to s3 to develop against the local container (bun run storage:local:start prints the
# exact block), or against a real S3-compatible bucket when deploying.
#
# Fail-closed rules enforced at startup:
#  - production refuses the filesystem driver, because a container disk does not survive deploys;
#  - a non-loopback endpoint needs PRIVATE_STORAGE_ALLOW_REMOTE_ENDPOINT=true, so a stray .env
#    cannot point a development machine at a real bucket.
PRIVATE_STORAGE_DRIVER="filesystem"
PRIVATE_STORAGE_LOCAL_ROOT=".storage"
# Where the browser reaches the signed local URLs. Defaults to http://127.0.0.1:${PORT}.
# PRIVATE_STORAGE_LOCAL_PUBLIC_URL=""
# Required together when PRIVATE_STORAGE_DRIVER=s3. Leave blank for the filesystem driver.
PRIVATE_STORAGE_REGION=""
PRIVATE_STORAGE_BUCKET=""
PRIVATE_STORAGE_ENDPOINT=""
PRIVATE_STORAGE_ACCESS_KEY_ID=""
PRIVATE_STORAGE_SECRET_ACCESS_KEY=""
# Local S3 servers cannot resolve <bucket>.<host>, so addressing goes in the path.
PRIVATE_STORAGE_FORCE_PATH_STYLE="false"
PRIVATE_STORAGE_ALLOW_REMOTE_ENDPOINT="false"
PRIVATE_STORAGE_UPLOAD_MAX_BYTES="5242880"
PRIVATE_STORAGE_UPLOAD_URL_TTL_SECONDS="900"
PRIVATE_STORAGE_DOWNLOAD_URL_TTL_SECONDS="300"
# Host port for the optional local S3 container. Derived per checkout when left unset.
# PRIVATE_STORAGE_S3_PORT="24331"

# Optional iOS App Store subscription verification. Leave credentials blank until
# App Store Connect products and API credentials are ready. Official Apple root
# certificates are bundled; APPLE_IAP_ROOT_CERTS_DIR is an optional override.
# When credentials are set, APPLE_IAP_PRODUCT_IDS must list every allowed product.
APPLE_IAP_BUNDLE_ID=""
APPLE_IAP_APP_APPLE_ID=""
APPLE_IAP_ENVIRONMENT="Sandbox"
APPLE_IAP_ISSUER_ID=""
APPLE_IAP_KEY_ID=""
APPLE_IAP_PRIVATE_KEY_BASE64=""
APPLE_IAP_ROOT_CERTS_DIR=""
APPLE_IAP_PRODUCT_IDS="com.example.app.premium.monthly,com.example.app.premium.yearly"

# Optional Google Play subscription verification. Leave credentials blank until
# Play Console products, base plans, and Android Publisher API access are ready.
# When credentials are set, both product and base-plan allowlists are required.
# Product/base-plan examples are public identifiers; the service-account JSON is a
# backend secret and should be base64-encoded before deployment.
GOOGLE_PLAY_PACKAGE_NAME=""
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_BASE64=""
GOOGLE_PLAY_PRODUCT_IDS="com.example.app.premium"
GOOGLE_PLAY_BASE_PLAN_IDS="monthly,yearly"

# Optional Expo Push access token. Leave blank unless the Expo project enables
# push security. APNs/FCM credentials are configured in Expo/EAS, not here.
EXPO_PUSH_ACCESS_TOKEN=""
ENABLE_TEST_PUSH="false"
PUSH_TOKEN_MAX_PER_USER="10"
PUSH_OUTBOX_PROCESS_LIMIT=""
PUSH_OUTBOX_PROCESS_MAX_LOOPS=""
PUSH_OUTBOX_PROCESS_MAX_RUNTIME_MS=""
PUSH_OUTBOX_PROCESSING_STALE_MS=""
PUSH_RECEIPT_CHECK_LIMIT=""
