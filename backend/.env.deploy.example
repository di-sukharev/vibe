# Yandex Cloud release configuration for `bun run release:yc`.
#
# Copy to `backend/.env.deploy`, which is git-ignored. These are identifiers, not secrets: the
# release script never reads a credential. Runtime secrets belong to the container revision and are
# set in the Yandex console or Lockbox, and the script carries them forward untouched.
#
# Provision the infrastructure named here once by following docs/YANDEX_CLOUD.md.

# Refuses to release when the active `yc` profile points somewhere else. This is the guard against
# releasing into the wrong folder. Read the two values with:
#
#   yc config get cloud-id
#   yc config get folder-id
#
# Not `yc config list`: it prints the profile's OAuth token next to the ids, and that output tends
# to get pasted into a chat or a ticket.
YC_EXPECTED_CLOUD_ID=
YC_EXPECTED_FOLDER_ID=

# Container Registry: `yc container registry get --name <registry> --format json | jq -r .id`.
YC_REGISTRY_ID=
YC_IMAGE_NAME=

# The private Serverless Container serving the API, and the service account its revisions run as.
YC_API_CONTAINER=
YC_SERVICE_ACCOUNT_ID=

# Sizing for the FIRST revision only. Every later release carries the live revision's cores,
# memory, core fraction, concurrency, timeout and service account forward, so a change made in the
# console is not reverted by a release - and is not overridden from here either.
# YC_API_CORES=1
# YC_API_MEMORY=1GB
# YC_API_CONCURRENCY=1
# YC_API_TIMEOUT=30s

# Migrations are not part of the release. Apply them from a protected operator environment before
# deploying, as described under "Managed PostgreSQL" in docs/YANDEX_CLOUD.md.

# Object Storage buckets for the static surfaces. Leave a bucket unset to skip that surface.
# Build both before `publish-web`; the script publishes what is already in `dist`.
# YC_WEBAPP_BUCKET=
# YC_WEBSITE_BUCKET=
# YC_STORAGE_ENDPOINT=https://storage.yandexcloud.net

# Readiness check after the release, through the API Gateway custom host.
# YC_HEALTH_URL=https://api.example.com/health/ready
