# DigitalOcean App Platform spec for the backend API, its database and the migration job.
#
# Copy this file to `.do/api-app.yaml`, fill in the identifiers marked REPLACE_WITH_*, and commit
# it. It is the shape of the deployment; it is not where secrets live.
#
# Secret values are deliberately absent. An env entry with a `key` and no `value` is filled from
# the running app by `bun run deploy:do api` on every deploy, so `JWT_SECRET` and the storage and
# email credentials are set once in the DigitalOcean console and never travel through this
# repository, a shell history, or a generated file on disk.
#
# On the very first deploy there is no running app to copy from, so those entries reach
# DigitalOcean empty and the API will not boot until you set them in the console. That order is
# intentional and documented in docs/DEPLOYMENT.md.
name: REPLACE_WITH_PROJECT_SLUG-api
region: REPLACE_WITH_DO_APP_REGION
alerts:
  - rule: DEPLOYMENT_FAILED
  - rule: DOMAIN_FAILED

# Browser auth requires the API and the webapp to be the same browser site, so the API needs a
# custom host under the same registrable domain as the webapp. See docs/DEPLOYMENT.md.
domains:
  - domain: REPLACE_WITH_API_DOMAIN
    type: PRIMARY

databases:
  - name: REPLACE_WITH_DO_DB_COMPONENT_NAME
    engine: PG
    version: "18"
    production: true
    cluster_name: REPLACE_WITH_DO_DB_CLUSTER_NAME
    db_name: REPLACE_WITH_DO_DB_NAME
    db_user: REPLACE_WITH_DO_DB_USER

services:
  - name: api
    github:
      repo: REPLACE_WITH_GITHUB_REPO
      branch: REPLACE_WITH_GIT_BRANCH
      deploy_on_push: false
    source_dir: /
    dockerfile_path: backend/Dockerfile
    http_port: 8080
    instance_size_slug: apps-s-1vcpu-1gb
    instance_count: 1
    health_check:
      http_path: /health/ready
      initial_delay_seconds: 10
      period_seconds: 10
      timeout_seconds: 5
      success_threshold: 1
      failure_threshold: 5
    liveness_health_check:
      http_path: /health/live
      initial_delay_seconds: 30
      period_seconds: 10
      timeout_seconds: 5
      success_threshold: 1
      failure_threshold: 5
    envs:
      - key: NODE_ENV
        value: production
        scope: RUN_TIME
        type: GENERAL
      - key: PORT
        value: "8080"
        scope: RUN_TIME
        type: GENERAL
      - key: DATABASE_URL
        value: "${REPLACE_WITH_DO_DB_COMPONENT_NAME.DATABASE_URL}"
        scope: RUN_TIME
        type: SECRET
      # Set in the DigitalOcean console: 64+ hex characters from `openssl rand -hex 32`.
      # backend/src/env.ts refuses to boot on a weak or placeholder value.
      - key: JWT_SECRET
        scope: RUN_TIME
        type: SECRET
      # Credentialed browser requests, so origins only - no wildcard, no paths.
      - key: CORS_ORIGINS
        value: "https://REPLACE_WITH_WEBAPP_DOMAIN"
        scope: RUN_TIME
        type: GENERAL
      - key: WEBAPP_ORIGIN
        value: "https://REPLACE_WITH_WEBAPP_DOMAIN"
        scope: RUN_TIME
        type: GENERAL
      - key: ACCESS_TOKEN_TTL_SECONDS
        value: "900"
        scope: RUN_TIME
        type: GENERAL
      - key: REFRESH_TOKEN_TTL_DAYS
        value: "30"
        scope: RUN_TIME
        type: GENERAL
      - key: REFRESH_REUSE_GRACE_SECONDS
        value: "10"
        scope: RUN_TIME
        type: GENERAL
      - key: SESSION_ABSOLUTE_TTL_DAYS
        value: "90"
        scope: RUN_TIME
        type: GENERAL
      - key: SESSION_RETENTION_DAYS
        value: "7"
        scope: RUN_TIME
        type: GENERAL
      - key: AUTH_BODY_LIMIT_BYTES
        value: "65536"
        scope: RUN_TIME
        type: GENERAL
      # `yandex-sws` turns the backend's own IP-keyed limits off because Smart Web Security does
      # that job at the edge. On App Platform nothing replaces them, so this stays `local`.
      - key: INGRESS_RATE_LIMIT_PROVIDER
        value: "local"
        scope: RUN_TIME
        type: GENERAL
      - key: AUTH_RATE_LIMIT_MAX
        value: "60"
        scope: RUN_TIME
        type: GENERAL
      - key: AUTH_RATE_LIMIT_WINDOW_SECONDS
        value: "60"
        scope: RUN_TIME
        type: GENERAL
      - key: ADMIN_USERS_READ_RATE_LIMIT_MAX
        value: "120"
        scope: RUN_TIME
        type: GENERAL
      - key: ADMIN_USERS_READ_RATE_LIMIT_WINDOW_SECONDS
        value: "60"
        scope: RUN_TIME
        type: GENERAL
      - key: IAP_BODY_LIMIT_BYTES
        value: "65536"
        scope: RUN_TIME
        type: GENERAL
      - key: IAP_RATE_LIMIT_MAX
        value: "60"
        scope: RUN_TIME
        type: GENERAL
      - key: IAP_RATE_LIMIT_WINDOW_SECONDS
        value: "60"
        scope: RUN_TIME
        type: GENERAL
      # Store webhooks arrive in bursts and carry larger bodies than a browser request.
      - key: WEBHOOK_BODY_LIMIT_BYTES
        value: "262144"
        scope: RUN_TIME
        type: GENERAL
      - key: WEBHOOK_RATE_LIMIT_MAX
        value: "600"
        scope: RUN_TIME
        type: GENERAL
      - key: WEBHOOK_RATE_LIMIT_WINDOW_SECONDS
        value: "60"
        scope: RUN_TIME
        type: GENERAL
      - key: SHUTDOWN_GRACE_SECONDS
        value: "20"
        scope: RUN_TIME
        type: GENERAL
      - key: TRUST_PROXY
        value: "true"
        scope: RUN_TIME
        type: GENERAL
      - key: TRUSTED_PROXY_CLIENT_IP_HEADER
        value: "do-connecting-ip"
        scope: RUN_TIME
        type: GENERAL
      - key: COOKIE_SECURE
        value: "true"
        scope: RUN_TIME
        type: GENERAL
      # File uploads. The backend refuses the filesystem driver under NODE_ENV=production because
      # an App Platform container's disk does not survive a redeploy, so a bucket is required.
      # Delete this group only if the install ships no uploads.
      - key: PRIVATE_STORAGE_DRIVER
        value: s3
        scope: RUN_TIME
        type: GENERAL
      - key: PRIVATE_STORAGE_ALLOW_REMOTE_ENDPOINT
        value: "true"
        scope: RUN_TIME
        type: GENERAL
      - key: PRIVATE_STORAGE_REGION
        value: REPLACE_WITH_STORAGE_REGION
        scope: RUN_TIME
        type: GENERAL
      - key: PRIVATE_STORAGE_BUCKET
        value: REPLACE_WITH_STORAGE_BUCKET
        scope: RUN_TIME
        type: GENERAL
      - key: PRIVATE_STORAGE_ENDPOINT
        value: REPLACE_WITH_STORAGE_ENDPOINT
        scope: RUN_TIME
        type: GENERAL
      - key: PRIVATE_STORAGE_ACCESS_KEY_ID
        scope: RUN_TIME
        type: SECRET
      - key: PRIVATE_STORAGE_SECRET_ACCESS_KEY
        scope: RUN_TIME
        type: SECRET
      # Transactional email. Delete this group when EMAIL_DELIVERY is absent; keep it whole
      # otherwise, because a half-configured provider accepts password-reset requests and silently
      # sends nothing. `postbox` also needs EMAIL_POSTBOX_REGION; `resend` needs neither key below.
      - key: EMAIL_DELIVERY
        value: REPLACE_WITH_EMAIL_DELIVERY
        scope: RUN_TIME
        type: GENERAL
      - key: EMAIL_FROM
        value: REPLACE_WITH_EMAIL_FROM
        scope: RUN_TIME
        type: GENERAL
      - key: EMAIL_POSTBOX_ACCESS_KEY_ID
        scope: RUN_TIME
        type: SECRET
      - key: EMAIL_POSTBOX_SECRET_ACCESS_KEY
        scope: RUN_TIME
        type: SECRET
      # Native subscriptions. Delete both store groups when the product will never sell them; keep
      # each one whole otherwise, because half a group accepts purchases and verifies none of them.
      # These belong to the API and to a Google-enabled maintenance job - never to the notification
      # worker, an unrelated cron, a static site, or any EXPO_PUBLIC_* variable. See docs/IAP.md.
      #
      #  - key: APPLE_IAP_BUNDLE_ID
      #    value: com.example.app
      #    scope: RUN_TIME
      #    type: GENERAL
      #  - key: APPLE_IAP_APP_APPLE_ID
      #    value: "1234567890"
      #    scope: RUN_TIME
      #    type: GENERAL
      #  # Sandbox receipts validate against the wrong service; production means Production.
      #  - key: APPLE_IAP_ENVIRONMENT
      #    value: Production
      #    scope: RUN_TIME
      #    type: GENERAL
      #  - key: APPLE_IAP_ISSUER_ID
      #    value: <issuer-id>
      #    scope: RUN_TIME
      #    type: GENERAL
      #  - key: APPLE_IAP_KEY_ID
      #    value: <key-id>
      #    scope: RUN_TIME
      #    type: GENERAL
      #  # Apple's root certificates, bundled in the backend image.
      #  - key: APPLE_IAP_ROOT_CERTS_DIR
      #    value: /app/backend/src/modules/billing/certs/apple
      #    scope: RUN_TIME
      #    type: GENERAL
      #  - key: APPLE_IAP_PRODUCT_IDS
      #    value: com.example.app.premium.monthly,com.example.app.premium.yearly
      #    scope: RUN_TIME
      #    type: GENERAL
      #  - key: APPLE_IAP_PRIVATE_KEY_BASE64
      #    scope: RUN_TIME
      #    type: SECRET
      #  - key: GOOGLE_PLAY_PACKAGE_NAME
      #    value: com.example.app
      #    scope: RUN_TIME
      #    type: GENERAL
      #  - key: GOOGLE_PLAY_PRODUCT_IDS
      #    value: com.example.app.premium
      #    scope: RUN_TIME
      #    type: GENERAL
      #  - key: GOOGLE_PLAY_BASE_PLAN_IDS
      #    value: monthly,yearly
      #    scope: RUN_TIME
      #    type: GENERAL
      #  - key: GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_BASE64
      #    scope: RUN_TIME
      #    type: SECRET
      #
      # Temporary, for verifying push from a real device through POST /api/notifications/test-push.
      # API-only: delivery belongs to the notification worker. Remove it once push is verified.
      #  - key: ENABLE_TEST_PUSH
      #    value: "true"
      #    scope: RUN_TIME
      #    type: GENERAL

# Worker components. Copy the API's PRIVATE_STORAGE_* and EMAIL_* groups into any block here:
# every runner builds storage and delivery through `createBackendRuntime`, and a worker is the
# process that actually sends. Give them neither JWT_SECRET nor cookie/CORS settings - a background
# component has no reason to hold the key that mints access tokens.
#
# `scheduler` is for an install that sends email: the outbox drain has to run about once a minute
# and the App Platform scheduler floor is 15, so the drain runs here rather than as a SCHEDULED
# job. `notifications` is the preferred push topology once the app sends notifications; it is the
# only component that gets EXPO_PUSH_ACCESS_TOKEN. See docs/BACKGROUND_JOBS.md and docs/IAP.md.
#
# workers:
#   - name: scheduler
#     github:
#       repo: REPLACE_WITH_GITHUB_REPO
#       branch: REPLACE_WITH_GIT_BRANCH
#       deploy_on_push: false
#     source_dir: /
#     dockerfile_path: backend/Dockerfile
#     run_command: bun run start:scheduler
#     instance_size_slug: apps-s-1vcpu-1gb
#     instance_count: 1
#     envs:
#       - key: DATABASE_URL
#         value: "${REPLACE_WITH_DO_DB_COMPONENT_NAME.DATABASE_URL}"
#         scope: RUN_TIME
#         type: SECRET
#   - name: notifications
#     github:
#       repo: REPLACE_WITH_GITHUB_REPO
#       branch: REPLACE_WITH_GIT_BRANCH
#       deploy_on_push: false
#     source_dir: /
#     dockerfile_path: backend/Dockerfile
#     run_command: bun run start:worker:notifications
#     instance_size_slug: apps-s-1vcpu-1gb
#     instance_count: 1
#     envs:
#       - key: DATABASE_URL
#         value: "${REPLACE_WITH_DO_DB_COMPONENT_NAME.DATABASE_URL}"
#         scope: RUN_TIME
#         type: SECRET
#       # Only when Expo Push Security is enabled.
#       - key: EXPO_PUSH_ACCESS_TOKEN
#         scope: RUN_TIME
#         type: SECRET

jobs:
  - name: migrate
    kind: PRE_DEPLOY
    github:
      repo: REPLACE_WITH_GITHUB_REPO
      branch: REPLACE_WITH_GIT_BRANCH
      deploy_on_push: false
    source_dir: /
    dockerfile_path: backend/Dockerfile
    run_command: bun run db:deploy
    instance_count: 1
    envs:
      - key: DATABASE_URL
        value: "${REPLACE_WITH_DO_DB_COMPONENT_NAME.DATABASE_URL}"
        scope: RUN_TIME
        type: SECRET
      # The first administrator, needed exactly once. `db:deploy` refuses to finish while the
      # database has no login-capable admin, so set these two in the console before the first
      # successful deploy - and delete them from the console right after it, because a later run
      # would unlock and reset that account again. Empty is read as absent, which is the steady
      # state. They are attached to the migration job only, never to the API.
      - key: ADMIN_SEED_EMAIL
        scope: RUN_TIME
        type: SECRET
      - key: ADMIN_SEED_PASSWORD
        scope: RUN_TIME
        type: SECRET

# Scheduled jobs. `bun run deploy:do api` checks each task name against backend/src/jobs.ts and
# refuses a cadence under 15 minutes, which is the App Platform floor. Production should normally
# schedule `maintenance:process`: it cleans auth sessions and expired reset tokens, redacts legacy
# terminal notification content, and reconciles stale Google Play purchases once subscriptions are
# on and that group is configured - give it the Google Play group in that case.
#
# `notifications:process` belongs here only in the budget topology, as its own second component,
# instead of the notifications worker above. Durable work belongs in the outbox drained by
# `outbox:drain`, not in a second scheduler. See docs/BACKGROUND_JOBS.md.
#
#  - name: maintenance
#    kind: SCHEDULED
#    github:
#      repo: REPLACE_WITH_GITHUB_REPO
#      branch: REPLACE_WITH_GIT_BRANCH
#      deploy_on_push: false
#    source_dir: /
#    dockerfile_path: backend/Dockerfile
#    run_command: bun run start:cron -- maintenance:process
#    instance_count: 1
#    schedule:
#      cron: "*/15 * * * *"
#      time_zone: UTC
#    envs:
#      - key: DATABASE_URL
#        value: "${REPLACE_WITH_DO_DB_COMPONENT_NAME.DATABASE_URL}"
#        scope: RUN_TIME
#        type: SECRET
