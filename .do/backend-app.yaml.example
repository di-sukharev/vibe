name: REPLACE_WITH_PROJECT_SLUG-api
region: REPLACE_WITH_DO_APP_REGION
alerts:
  - rule: DEPLOYMENT_FAILED
  - rule: DOMAIN_FAILED
databases:
  - name: REPLACE_WITH_DO_DB_COMPONENT_NAME
    engine: PG
    version: "18"
    production: true
    cluster_name: REPLACE_WITH_DO_DB_CLUSTER_NAME
    db_name: REPLACE_WITH_DO_DB_NAME
    db_user: REPLACE_WITH_DO_DB_USER
services:
  - name: api
    github:
      repo: REPLACE_WITH_GITHUB_REPO
      branch: REPLACE_WITH_GIT_BRANCH
      deploy_on_push: true
    source_dir: /
    dockerfile_path: backend/Dockerfile
    http_port: 8080
    instance_size_slug: REPLACE_WITH_DO_API_INSTANCE_SIZE_SLUG
    instance_count: REPLACE_WITH_DO_API_INSTANCE_COUNT
    health_check:
      http_path: /health/ready
      initial_delay_seconds: 10
      period_seconds: 10
      timeout_seconds: 5
      success_threshold: 1
      failure_threshold: 5
    liveness_health_check:
      http_path: /health/live
      initial_delay_seconds: 30
      period_seconds: 10
      timeout_seconds: 5
      success_threshold: 1
      failure_threshold: 5
    envs:
      - key: PORT
        value: "8080"
        scope: RUN_TIME
        type: GENERAL
      - key: DATABASE_URL
        value: "${REPLACE_WITH_DO_DB_COMPONENT_NAME.DATABASE_URL}"
        scope: RUN_TIME
        type: SECRET
      - key: JWT_SECRET
        value: "REPLACE_WITH_64_HEX_JWT_SECRET"
        scope: RUN_TIME
        type: SECRET
      - key: CORS_ORIGINS
        value: "https://REPLACE_WITH_WEBAPP_DEFAULT_INGRESS"
        scope: RUN_TIME
        type: GENERAL
      - key: ACCESS_TOKEN_TTL_SECONDS
        value: "900"
        scope: RUN_TIME
        type: GENERAL
      - key: REFRESH_TOKEN_TTL_DAYS
        value: "30"
        scope: RUN_TIME
        type: GENERAL
      - key: REFRESH_REUSE_GRACE_SECONDS
        value: "10"
        scope: RUN_TIME
        type: GENERAL
      - key: SESSION_ABSOLUTE_TTL_DAYS
        value: "90"
        scope: RUN_TIME
        type: GENERAL
      - key: SESSION_RETENTION_DAYS
        value: "7"
        scope: RUN_TIME
        type: GENERAL
      - key: AUTH_BODY_LIMIT_BYTES
        value: "65536"
        scope: RUN_TIME
        type: GENERAL
      - key: INGRESS_RATE_LIMIT_PROVIDER
        value: "local"
        scope: RUN_TIME
        type: GENERAL
      - key: AUTH_RATE_LIMIT_MAX
        value: "60"
        scope: RUN_TIME
        type: GENERAL
      - key: AUTH_RATE_LIMIT_WINDOW_SECONDS
        value: "60"
        scope: RUN_TIME
        type: GENERAL
      - key: ADMIN_USERS_READ_RATE_LIMIT_MAX
        value: "120"
        scope: RUN_TIME
        type: GENERAL
      - key: ADMIN_USERS_READ_RATE_LIMIT_WINDOW_SECONDS
        value: "60"
        scope: RUN_TIME
        type: GENERAL
      - key: IAP_BODY_LIMIT_BYTES
        value: "65536"
        scope: RUN_TIME
        type: GENERAL
      - key: IAP_RATE_LIMIT_MAX
        value: "60"
        scope: RUN_TIME
        type: GENERAL
      - key: IAP_RATE_LIMIT_WINDOW_SECONDS
        value: "60"
        scope: RUN_TIME
        type: GENERAL
      - key: WEBHOOK_BODY_LIMIT_BYTES
        value: "262144"
        scope: RUN_TIME
        type: GENERAL
      - key: WEBHOOK_RATE_LIMIT_MAX
        value: "600"
        scope: RUN_TIME
        type: GENERAL
      - key: WEBHOOK_RATE_LIMIT_WINDOW_SECONDS
        value: "60"
        scope: RUN_TIME
        type: GENERAL
      - key: SHUTDOWN_GRACE_SECONDS
        value: "20"
        scope: RUN_TIME
        type: GENERAL
      - key: TRUST_PROXY
        value: "true"
        scope: RUN_TIME
        type: GENERAL
      - key: TRUSTED_PROXY_CLIENT_IP_HEADER
        value: "do-connecting-ip"
        scope: RUN_TIME
        type: GENERAL
      - key: COOKIE_SECURE
        value: "true"
        scope: RUN_TIME
        type: GENERAL
REPLACE_WITH_OPTIONAL_ENABLE_TEST_PUSH_ENV
REPLACE_WITH_OPTIONAL_IAP_ENVS
REPLACE_WITH_STORAGE_ENVS
REPLACE_WITH_EMAIL_ENVS
REPLACE_WITH_OPTIONAL_BACKEND_WORKERS
jobs:
  - name: migrate
    kind: PRE_DEPLOY
    github:
      repo: REPLACE_WITH_GITHUB_REPO
      branch: REPLACE_WITH_GIT_BRANCH
      deploy_on_push: true
    source_dir: /
    dockerfile_path: backend/Dockerfile
    run_command: bun run db:deploy
    instance_count: 1
    envs:
      - key: DATABASE_URL
        value: "${REPLACE_WITH_DO_DB_COMPONENT_NAME.DATABASE_URL}"
        scope: RUN_TIME
        type: SECRET
REPLACE_WITH_INITIAL_ADMIN_ENVS
REPLACE_WITH_OPTIONAL_BACKEND_CRON_JOBS
