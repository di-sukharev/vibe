# DigitalOcean App Platform spec for the CSR webapp.
#
# Copy to `.do/webapp-app.yaml`, fill in the REPLACE_WITH_* identifiers, commit it, and deploy with
# `bun run deploy:do webapp`. A Static Site component has no machine tier and no runtime secrets.
#
# The host must sit under the same registrable domain as the API host, or the browser treats the
# refresh cookie as third-party and auth breaks after the first token expiry. See docs/DEPLOYMENT.md.
name: REPLACE_WITH_PROJECT_SLUG-webapp
region: REPLACE_WITH_DO_APP_REGION
alerts:
  - rule: DEPLOYMENT_FAILED
  - rule: DOMAIN_FAILED

domains:
  - domain: REPLACE_WITH_WEBAPP_DOMAIN
    type: PRIMARY

static_sites:
  - name: webapp
    github:
      repo: REPLACE_WITH_GITHUB_REPO
      branch: REPLACE_WITH_GIT_BRANCH
      deploy_on_push: false
    source_dir: /
    environment_slug: node-js
    build_command: bun install --frozen-lockfile && bun run build:webapp
    output_dir: webapp/dist
    index_document: index.html
    # Client-side routing: every unmatched path serves the SPA shell rather than a 404.
    catchall_document: index.html
    envs:
      # Baked into the bundle at build time, so a change here needs a rebuild, not a restart.
      - key: VITE_API_URL
        value: "https://REPLACE_WITH_API_DOMAIN"
        scope: BUILD_TIME
        type: GENERAL
